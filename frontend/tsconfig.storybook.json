{
  "extends": "./tsconfig.app.json",
  "include": [
    ".storybook/**/*",
    "mocks/**/*",
    "src/**/*.mocks.*",
    "src/**/*.stories.*",
    "src/types/**/*",
    "env.d.ts",
    "typed-router.d.ts"
  ],
  "exclude": ["src/**/*.spec.*"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.storybook.tsbuildinfo",

    "types": ["node"],

    "paths": {
      "@/*": ["./src/*"],
      "@mocks/*": ["./mocks/*"]
    }
  }
}
